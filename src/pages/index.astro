<script>
  // Form handling logic strictly complying with Business Rules
  const form = document.getElementById('ltb-quote-form') as HTMLFormElement;
  const statusBox = document.getElementById('quote-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('quote-name') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('quote-phone') as HTMLInputElement)?.value.trim();
    const type = (document.getElementById('quote-type') as HTMLSelectElement)?.value;
    const qty = (document.getElementById('quote-qty') as HTMLInputElement)?.value.trim();
    const note = (document.getElementById('quote-note') as HTMLTextAreaElement)?.value.trim();

    if (!name || !phone) {
      alert('Vui lòng nhập Tên và Số điện thoại để nhận báo giá sỉ.');
      return;
    }

    if (statusBox) {
      statusBox.innerHTML = `
        <div class="font-bold text-[#D4AA4A] text-[13px] uppercase tracking-wide">✓ Đã tiếp nhận yêu cầu báo giá!</div>
        <div class="mt-2 text-white"><b>Khách hàng:</b> ${name} - <b>SĐT:</b> ${phone}</div>
        <div><b>Danh mục:</b> ${type} ${qty ? `(SL: ${qty})` : ''}</div>
        <div class="mt-2 text-[#9ca3af]">Chúng tôi sẽ liên hệ lại trong 30 phút làm việc (7:00 - 19:00). Lưu ý: Đây là yêu cầu tiếp nhận báo giá, không đồng nghĩa với đơn hàng đã được xác nhận.</div>
      `;
      statusBox.classList.remove('hidden');
    }

    form.reset();
  });
</script>
