---
import PublicLayout from '../layouts/PublicLayout.astro';
import { SITE } from '../lib/site';
---

<PublicLayout
  title="Bia Long Thành (LTB) — Chuyên Phân Phối Bia & Gia Công Bia Craft Uy Tín Tại Long Thành, Đồng Nai"
  bodyClass="bg-[#faf9f6] font-sans text-[#0e0e0e] antialiased selection:bg-[#B68D2E] selection:text-black overflow-x-hidden"
  active="trang-chu"
>
  <div class="min-h-screen w-full bg-[#faf9f6] text-[#0e0e0e] overflow-clip selection:bg-[#B68D2E] selection:text-black max-w-[100vw]">
    
    <!-- SECTION 1: HERO SHOWCASE (#trang-chu) -->
    <section id="trang-chu" class="relative pt-[72px] lg:pt-[76px] bg-[#0E0E0E] text-[#faf9f6] overflow-hidden">
      <!-- Background SVG Noise -->
      <div
        class="absolute inset-0 opacity-[0.04] pointer-events-none"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noiseFilter\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noiseFilter)\'/%3E%3C/svg%3E');"
      ></div>

      <!-- Radial dots texture -->
      <div
        class="absolute inset-0 opacity-[0.06]"
        style="background-image: radial-gradient(circle at 1px 1px, #D4AA4A 1px, transparent 0); background-size: 28px 28px;"
      ></div>

      <!-- Ambient glow lights -->
      <div class="absolute -top-[30%] -right-[15%] h-[780px] w-[780px] rounded-full bg-[radial-gradient(circle_at_center,rgba(182,141,46,0.28),transparent_68%)] blur-[1px]"></div>
      <div class="absolute -bottom-[20%] -left-[10%] h-[600px] w-[600px] rounded-full bg-[radial-gradient(circle_at_center,rgba(140,107,31,0.18),transparent_70%)] blur-[2px]"></div>

      <!-- Watermark logos -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.05] pointer-events-none select-none">
        <img
          src="/brand/ref-fA.png"
          alt=""
          aria-hidden="true"
          class="h-[520px] lg:h-[720px] w-auto object-contain"
          style="filter: drop-shadow(0 0 30px rgba(182,141,46,0.2));"
        />
      </div>
      <div class="absolute top-[92px] right-4 lg:right-[6%] opacity-[0.04] pointer-events-none select-none hidden lg:block">
        <img
          src="/brand/ref-fA.png"
          alt=""
          aria-hidden="true"
          class="h-[320px] w-auto object-contain"
        />
      </div>

      <!-- Hero Grid Content -->
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-[80px] grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-8 lg:gap-12 items-center relative">
        <!-- Left: Copy & CTAs -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-[#B68D2E]/30 bg-[#16140e] px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.16em] text-[#D4AA4A]">
            <img
              src="/brand/ref-fA.png"
              alt=""
              aria-hidden="true"
              class="h-4 w-auto object-contain logo-gold-shadow"
            />
            <span>Đại Lý Cấp 1 • Nhà Sản Xuất Bia Craft Long Thành</span>
          </div>

          <!-- Main Heading -->
          <h1 class="mt-5 font-black leading-[1.08] sm:leading-[1] lg:leading-[0.94] tracking-[-0.02em] text-[26px] xs:text-[30px] sm:text-[42px] lg:text-[52px] uppercase">
            CHUYÊN PHÂN PHỐI <span class="gold-text-gradient">BIA &amp; GIA CÔNG</span> BIA CRAFT TẠI LONG THÀNH
          </h1>

          <!-- Body intro -->
          <p class="mt-4 sm:mt-5 text-[14.5px] sm:text-[15.5px] leading-[1.7] text-[#c9c2ab] max-w-[580px]">
            Công ty TNHH Bia Long Thành — MST <span class="text-white font-semibold">3603823707</span> — Chuyên bán buôn bia thương mại chính hãng và gia công sản xuất bia craft (bia thủ công theo yêu cầu). Giao hàng nhanh 24/7 tại Long Phước, Long Thành, Nhơn Trạch, Biên Hòa. Đầy đủ hóa đơn VAT.
          </p>

          <!-- Dual Action Buttons -->
          <div class="mt-6 sm:mt-7 flex flex-col xs:flex-row flex-wrap gap-3">
            <a
              href="#lien-he"
              class="h-[48px] rounded-full px-6 sm:px-7 bg-[linear-gradient(102deg,#B68D2E_0%,#8C6B1F_100%)] text-white font-extrabold text-[13px] tracking-wide uppercase flex items-center justify-center gap-2 shadow-[0_10px_28px_rgba(182,141,46,0.4)] hover:translate-y-[-1px] hover:brightness-110 active:scale-[0.98] transition-all"
            >
              <span>Liên hệ báo giá</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a
              href="#san-pham"
              class="h-[48px] rounded-full px-6 sm:px-7 bg-[#1c1c1c] border border-[#B68D2E]/25 text-[#f5f0d8] font-bold text-[13px] tracking-wide uppercase hover:bg-[#232323] hover:border-[#B68D2E]/50 active:scale-[0.98] transition flex items-center justify-center"
            >
              <span>Xem sản phẩm</span>
            </a>
          </div>

          <!-- 3 KPI Feature Blocks -->
          <div class="mt-8 sm:mt-10 grid grid-cols-3 gap-2.5 sm:gap-3 max-w-[540px]">
            <div class="rounded-[16px] bg-[#151515] border border-[#B68D2E]/20 p-3 sm:p-4 hover:border-[#B68D2E]/40 transition-colors flex flex-col justify-center">
              <div class="text-[19px] sm:text-[22px] font-black text-[#D4AA4A] tracking-tight">500+</div>
              <div class="text-[11px] sm:text-[12px] font-bold uppercase tracking-wide mt-0.5 text-white">Đại lý &amp; quán</div>
              <div class="text-[10px] sm:text-[11px] text-[#8a8676] mt-0.5">Tin cậy tại ĐN</div>
            </div>
            <div class="rounded-[16px] bg-[#151515] border border-[#B68D2E]/20 p-3 sm:p-4 hover:border-[#B68D2E]/40 transition-colors flex flex-col justify-center">
              <div class="text-[19px] sm:text-[22px] font-black text-[#D4AA4A] tracking-tight">24/7</div>
              <div class="text-[11px] sm:text-[12px] font-bold uppercase tracking-wide mt-0.5 text-white">Giao hàng</div>
              <div class="text-[10px] sm:text-[11px] text-[#8a8676] mt-0.5">Kể cả CN, Lễ</div>
            </div>
            <div class="rounded-[16px] bg-[#151515] border border-[#B68D2E]/20 p-3 sm:p-4 hover:border-[#B68D2E]/40 transition-colors flex flex-col justify-center">
              <div class="text-[19px] sm:text-[22px] font-black text-[#D4AA4A] tracking-tight">VAT</div>
              <div class="text-[11px] sm:text-[12px] font-bold uppercase tracking-wide mt-0.5 text-white">Hóa đơn đầy đủ</div>
              <div class="text-[10px] sm:text-[11px] text-[#8a8676] mt-0.5">MST 3603823707</div>
            </div>
          </div>
        </div>

        <!-- Right: Showcase Image & Floating Credential Cards -->
        <div class="relative min-w-0 mt-4 lg:mt-0">
          <div class="absolute -inset-4 rounded-[32px] bg-[radial-gradient(circle_at_30%_30%,rgba(212,170,74,0.22),rgba(182,141,46,0.18)_30%,transparent_68%)] blur-[12px] pointer-events-none"></div>
          
          <div class="relative rounded-[24px] sm:rounded-[28px] overflow-hidden border border-[#B68D2E]/25 bg-[#111] shadow-[0_24px_80px_rgba(0,0,0,0.5)] max-w-full">
            <img
              src="/brand/ref-il.webp"
              alt="Bia Việt Premium Splash - Nhà phân phối LTB"
              class="w-full h-[360px] sm:h-[480px] lg:h-[620px] object-cover max-w-full hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

            <!-- Top Floating Header inside photo -->
            <div class="absolute top-3.5 left-3.5 right-3.5 flex justify-between items-start gap-2">
              <div class="rounded-full bg-black/75 backdrop-blur-md border border-[#B68D2E]/35 px-3 py-1.5 text-[9.5px] sm:text-[10.5px] uppercase tracking-[0.14em] font-bold flex items-center gap-2 text-[#D4AA4A] min-w-0">
                <img
                  src="/brand/ref-fA.png"
                  alt=""
                  aria-hidden="true"
                  class="h-4 sm:h-5 w-auto object-contain logo-gold-shadow shrink-0"
                />
                <span class="truncate">LONG THANH BEER • MST 3603823707</span>
              </div>
              <div class="h-8 w-8 sm:h-9 sm:w-9 rounded-full bg-black/60 backdrop-blur border border-[#B68D2E]/25 grid place-items-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#B68D2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 22 16 8"></path>
                  <path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"></path>
                </svg>
              </div>
            </div>

            <!-- Bottom Floating Bar inside photo -->
            <div class="absolute bottom-0 inset-x-0 p-3.5 sm:p-5 flex items-center justify-between gap-3 max-w-full">
              <div class="rounded-full bg-black/75 backdrop-blur-md border border-white/15 px-3.5 py-1.5 sm:px-4 sm:py-2 text-[10px] sm:text-[11px] uppercase tracking-wide font-bold flex items-center gap-2 text-white min-w-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 text-[#B68D2E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                </svg>
                <span class="truncate">Kho Phước Hòa • Giao nhanh Đồng Nai</span>
              </div>
              <div class="h-8 w-8 sm:h-10 sm:w-10 rounded-full bg-[#0a0a0a] border border-[#B68D2E]/30 grid place-items-center overflow-hidden shrink-0">
                <img
                  src="/brand/ref-fA.png"
                  alt=""
                  aria-hidden="true"
                  class="h-5 sm:h-7 w-auto object-contain"
                />
              </div>
            </div>
          </div>

          <!-- Bottom Floating Card (Repositioned to flow naturally without covering) -->
          <div class="mt-3 lg:mt-0 lg:absolute lg:-bottom-6 lg:left-4 rounded-[18px] bg-white text-black border border-[#e8dfbe] shadow-[0_18px_40px_rgba(0,0,0,0.18)] p-3.5 sm:p-4 w-full lg:w-[min(340px,90%)]">
            <div class="flex items-start gap-3">
              <div class="h-10 w-10 rounded-full bg-[#0e0e0e] border border-[#B68D2E]/30 grid place-items-center overflow-hidden p-1 shrink-0">
                <img
                  src="/brand/ref-fA.png"
                  alt=""
                  aria-hidden="true"
                  class="h-8 w-auto object-contain"
                />
              </div>
              <div class="leading-tight min-w-0">
                <div class="text-[10.5px] uppercase tracking-[0.16em] font-extrabold text-[#B68D2E]">
                  Pháp lý minh bạch • MST 3603823707
                </div>
                <div class="text-[13px] font-extrabold mt-1 text-[#1a1a1a] truncate">
                  CÔNG TY TNHH BIA LONG THÀNH
                </div>
                <div class="text-[11px] text-[#6b6b6b] mt-1 leading-[1.5]">
                  Cấp ngày 19/08/2021 • Ngành 4633: Bán buôn bia &amp; gia công bia craft
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: GIỚI THIỆU DOANH NGHIỆP (#gioi-thieu) -->
    <section id="gioi-thieu" class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-8 py-14 lg:py-24 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 lg:gap-16 items-start bg-white">
      <!-- Left: Real Warehouse Photo & Floating Core Badges -->
      <div class="relative min-w-0">
        <div class="rounded-[28px] overflow-hidden border border-[#ece6d3] bg-white shadow-[0_8px_32px_rgba(182,141,46,0.08)]">
          <img
            src="/brand/ref-ol.webp"
            alt="Kho phân phối bia Long Thành tại Phước Hòa"
            class="w-full h-[420px] lg:h-[560px] object-cover max-w-full"
          />
        </div>

        <div class="absolute -bottom-6 right-2 lg:right-4 rounded-[20px] bg-[#0e0e0e] text-white p-5 border border-[#B68D2E]/20 w-[min(280px,92%)] shadow-[0_20px_50px_rgba(0,0,0,0.4)] max-w-full">
          <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.16em] font-bold text-[#D4AA4A]">
            <img
              src="/brand/ref-fA.png"
              alt=""
              aria-hidden="true"
              class="h-4 w-auto"
            />
            <span>Năng lực cốt lõi</span>
          </div>
          <div class="mt-3 space-y-3">
            <div class="flex items-center gap-2 text-[13px] font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#B68D2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Kho &gt;1000m² tại Phước Hòa</span>
            </div>
            <div class="flex items-center gap-2 text-[13px] font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#B68D2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Giao hàng 24/7 toàn Đồng Nai</span>
            </div>
            <div class="flex items-center gap-2 text-[13px] font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#B68D2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Đầy đủ giấy phép 4633</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Narrative, Advantages & Historical Milestones -->
      <div class="min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full bg-[#fdf6de] border border-[#e8d9a8] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-[#8C6B1F]">
          <img
            src="/brand/ref-fA.png"
            alt=""
            aria-hidden="true"
            class="h-4 w-auto object-contain"
          />
          <span>Về chúng tôi • LTB GOLD</span>
        </div>

        <h2 class="mt-4 text-[30px] lg:text-[40px] font-black leading-[0.95] tracking-[-0.03em] uppercase text-[#1a1a1a]">
          Nhà phân phối <br />đáng tin cậy <br />
          <span class="gold-text-gradient">từ 2021</span>
        </h2>

        <p class="mt-5 text-[15px] leading-[1.75] text-[#3a3a3a]">
          CÔNG TY TNHH BIA LONG THÀNH (LTB) hoạt động theo MST <b class="text-[#8C6B1F]">3603823707</b> từ ngày 19/08/2021, chuyên tâm vào hai mảng mũi nhọn: <b>Phân phối bán buôn bia chính hãng</b> và <b>Gia công sản xuất bia craft (bia thủ công OEM/ODM)</b> theo công thức độc quyền. Chúng tôi cam kết uy tín pháp lý, nguồn hàng xuất xưởng chuẩn vị và dịch vụ giao vận tận nơi.
        </p>

        <!-- 4 Key Advantages Grid -->
        <div class="mt-6 grid sm:grid-cols-2 gap-3 min-w-0">
          <div class="rounded-[16px] border border-[#ece6d3] bg-white p-4 min-w-0 hover:border-[#B68D2E]/30 transition-colors">
            <div class="font-bold text-[13px] uppercase tracking-wide text-[#1a1a1a]">Phân phối bia chính hãng</div>
            <div class="mt-1 text-[12.5px] leading-[1.6] text-[#6b6b6b]">Heineken, Tiger, Saigon, 333, Budweiser... nhập trực tiếp, hóa đơn VAT đầy đủ.</div>
          </div>
          <div class="rounded-[16px] border border-[#ece6d3] bg-white p-4 min-w-0 hover:border-[#B68D2E]/30 transition-colors">
            <div class="font-bold text-[13px] uppercase tracking-wide text-[#1a1a1a]">Gia công bia craft (OEM)</div>
            <div class="mt-1 text-[12.5px] leading-[1.6] text-[#6b6b6b]">Nấu ủ bia thủ công theo gu riêng: IPA, Wheat Ale, Stout, Amber Lager dạng Keg &amp; Chai.</div>
          </div>
          <div class="rounded-[16px] border border-[#ece6d3] bg-white p-4 min-w-0 hover:border-[#B68D2E]/30 transition-colors">
            <div class="font-bold text-[13px] uppercase tracking-wide text-[#1a1a1a]">Giá sỉ &amp; MOQ linh hoạt</div>
            <div class="mt-1 text-[12.5px] leading-[1.6] text-[#6b6b6b]">Chiết khấu cạnh tranh cho đại lý, quán ăn, bar club và đối tác gia công mẻ vừa &amp; lớn.</div>
          </div>
          <div class="rounded-[16px] border border-[#ece6d3] bg-white p-4 min-w-0 hover:border-[#B68D2E]/30 transition-colors">
            <div class="font-bold text-[13px] uppercase tracking-wide text-[#1a1a1a]">Hỗ trợ xuất hóa đơn VAT</div>
            <div class="mt-1 text-[12.5px] leading-[1.6] text-[#6b6b6b]">Hợp đồng kinh tế minh bạch, xuất hóa đơn VAT chuẩn MST 3603823707 - LONG THANH BEER.</div>
          </div>
        </div>

        <!-- 3 Milestone Timeline -->
        <div class="mt-8 border-l-2 border-[#B68D2E]/30 pl-6 space-y-6">
          <div class="relative">
            <div class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-[#B68D2E] border-2 border-white shadow-[0_0_0_3px_rgba(182,141,46,0.15)]"></div>
            <div class="text-[12px] font-black tracking-[0.16em] text-[#B68D2E]">2021</div>
            <div class="font-bold mt-1 text-[#1a1a1a]">Thành lập</div>
            <div class="text-[13px] text-[#6b6b6b] leading-[1.6] mt-1">CÔNG TY TNHH BIA LONG THÀNH được cấp MST 3603823707, đại diện HOÀNG XUÂN DŨNG.</div>
          </div>
          <div class="relative">
            <div class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-[#B68D2E] border-2 border-white shadow-[0_0_0_3px_rgba(182,141,46,0.15)]"></div>
            <div class="text-[12px] font-black tracking-[0.16em] text-[#B68D2E]">2022</div>
            <div class="font-bold mt-1 text-[#1a1a1a]">Mở rộng kho Phước Hòa</div>
            <div class="text-[13px] text-[#6b6b6b] leading-[1.6] mt-1">Đầu tư kho &gt;1000m², đội xe tải giao hàng nội huyện và liên tỉnh.</div>
          </div>
          <div class="relative">
            <div class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-[#B68D2E] border-2 border-white shadow-[0_0_0_3px_rgba(182,141,46,0.15)]"></div>
            <div class="text-[12px] font-black tracking-[0.16em] text-[#B68D2E]">2024</div>
            <div class="font-bold mt-1 text-[#1a1a1a]">Cập nhật địa chỉ mới</div>
            <div class="text-[13px] text-[#6b6b6b] leading-[1.6] mt-1">1401/2, tổ 17, ấp Phước Hòa, Xã Long Phước, Tỉnh Đồng Nai sau sáp nhập 2025.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: SẢN PHẨM & DỊCH VỤ (#san-pham) -->
    <section id="san-pham" class="relative border-y border-[#1e1c14] bg-[#0E0E0E] text-white overflow-hidden">
      <!-- Background texture dl -->
      <div class="absolute inset-0 opacity-[0.08]">
        <img
          src="/brand/ref-dl.webp"
          alt=""
          class="h-full w-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0E0E0E] via-[#0E0E0E]/92 to-[#0E0E0E]"></div>
      <div
        class="absolute inset-0 opacity-[0.03]"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'n\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23n)\'/%3E%3C/svg%3E');"
      ></div>

      <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
        <!-- Section Title & Description -->
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
