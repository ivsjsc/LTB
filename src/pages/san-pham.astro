---
import PublicLayout from '../layouts/PublicLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import OrderStatusBadge from '../components/OrderStatusBadge.astro';
import { products } from '../data/products';
const productDataMap = Object.fromEntries(products.map((p) => [p.sku, { title: p.name, desc: p.modalDesc }]));
---
<PublicLayout title="Long Thanh Beer (LTB) - Cổng Phân Phối Thương Mại B2B" bodyClass="bg-background font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-on-secondary-container" active="san-pham">
<main class="w-full pt-20 bg-background"><div class="flex flex-col w-full">
<!-- Top Command & Commercial Title Section -->
<section class="w-full bg-surface-container-low px-gutter-mobile md:px-margin-tablet lg:px-margin py-space-xl">
<div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-space-lg">
<div class="max-w-3xl flex flex-col gap-space-xs">
<div class="flex items-center gap-space-xs text-secondary">
<span class="material-symbols-outlined text-[18px]">verified</span>
<span class="font-label-md tracking-widest uppercase">Phân Phối Chính Ngạch Đồng Nai • Tiêu Chuẩn ISO 22000</span>
</div>
<h1 class="font-headline-xl text-primary tracking-tight">Danh Mục Cung Ứng Đồ Uống B2B</h1>
<p class="font-body-lg text-on-surface-variant max-w-2xl">
          Bảng danh mục sản phẩm chính ngạch dành riêng cho Hệ thống Đại lý, Nhà hàng, Quán Bar và Chuỗi F&amp;B. Cung ứng số lượng lớn, giao lạnh chuẩn hóa và hồ sơ pháp lý minh bạch.
        </p>
</div>
<!-- Action Panel & Quick Specs -->
<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm">
<a class="px-space-md py-3 rounded bg-surface-container hover:bg-surface-container-high text-on-surface font-label-lg transition-colors flex items-center justify-center gap-space-xs border border-outline-variant/40" href="#chinh-sach-b2b">
<span class="material-symbols-outlined text-[18px]">policy</span>
<span class="">Chính sách MOQ</span>
</a>
<a class="px-space-md py-3 rounded bg-secondary text-on-secondary hover:bg-on-secondary-container font-label-lg transition-colors flex items-center justify-center gap-space-xs border border-outline-variant/40" href="/lien-he#yeu-cau-bao-gia">
<span class="material-symbols-outlined text-[18px]">request_quote</span>
<span class="">Yêu cầu báo giá</span>
</a>
</div>
</div>
<!-- Quick Metrics Banner -->
<div class="max-w-7xl mx-auto mt-space-lg grid grid-cols-2 md:grid-cols-4 gap-space-sm">
<div class="p-space-md bg-surface-container-lowest rounded flex items-center gap-space-sm border border-outline-variant/40">
<div class="w-10 h-10 rounded bg-primary-container/10 text-primary-container flex items-center justify-center">
<span class="material-symbols-outlined">inventory_2</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Quy cách đóng gói</span>
<span class="font-headline-sm text-primary font-bold">Keg 20L • Thùng 24</span>
</div>
</div>
<div class="p-space-md bg-surface-container-lowest rounded flex items-center gap-space-sm border border-outline-variant/40">
<div class="w-10 h-10 rounded bg-secondary-fixed/50 text-secondary flex items-center justify-center">
<span class="material-symbols-outlined">ac_unit</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Chuỗi lạnh bảo quản</span>
<span class="font-headline-sm text-primary font-bold">2°C - 4°C Tiêu chuẩn</span>
</div>
</div>
<div class="p-space-md bg-surface-container-lowest rounded flex items-center gap-space-sm border border-outline-variant/40">
<div class="w-10 h-10 rounded bg-primary-fixed/40 text-on-primary-fixed-variant flex items-center justify-center">
<span class="material-symbols-outlined">local_shipping</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Cam kết điều vận</span>
<span class="font-headline-sm text-primary font-bold">Nội tỉnh &lt; 24h</span>
</div>
</div>
<div class="p-space-md bg-surface-container-lowest rounded flex items-center gap-space-sm border border-outline-variant/40">
<div class="w-10 h-10 rounded bg-surface-container-highest text-on-surface flex items-center justify-center">
<span class="material-symbols-outlined">receipt_long</span>
</div>
<div class="flex flex-col">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Chứng từ thanh toán</span>
<span class="font-headline-sm text-primary font-bold">VAT 100% Khớp đơn</span>
</div>
</div>
</div>
</section>
<!-- Filter & Navigation Workspace -->
<section class="sticky top-20 z-40 w-full bg-surface-container/95 px-gutter-mobile md:px-margin-tablet lg:px-margin py-space-sm border border-outline-variant/40">
<div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
<!-- Main Category Tabs -->
<div class="flex items-center gap-space-xs overflow-x-auto no-scrollbar py-1" id="categoryNav">
<button class="cat-pill active px-space-md py-2 rounded bg-primary text-on-primary font-label-md tracking-wide whitespace-nowrap border border-outline-variant/40" data-category="all">
          Tất cả sản phẩm (6)
        </button>
<button class="cat-pill px-space-md py-2 rounded bg-surface-container-lowest hover:bg-surface-container-high text-on-surface font-label-md tracking-wide whitespace-nowrap transition-colors border border-outline-variant/40" data-category="keg">
          Bia Keg &amp; Bia Tươi Thủ Công (20L)
        </button>
<button class="cat-pill px-space-md py-2 rounded bg-surface-container-lowest hover:bg-surface-container-high text-on-surface font-label-md tracking-wide whitespace-nowrap transition-colors border border-outline-variant/40" data-category="pack">
          Bia Lon &amp; Chai Cao Cấp
        </button>
<button class="cat-pill px-space-md py-2 rounded bg-surface-container-lowest hover:bg-surface-container-high text-on-surface font-label-md tracking-wide whitespace-nowrap transition-colors border border-outline-variant/40" data-category="non-alc">
          Đồ Uống Không Cồn
        </button>
<button class="cat-pill px-space-md py-2 rounded bg-surface-container-lowest hover:bg-surface-container-high text-on-surface font-label-md tracking-wide whitespace-nowrap transition-colors border border-outline-variant/40" data-category="tobacco">
          Thuốc Lá Hợp Chuẩn B2B
        </button>
</div>
<!-- Packaging Dimension Filters -->
<div class="flex items-center gap-space-xs self-start lg:self-center">
<span class="font-label-sm text-on-surface-variant whitespace-nowrap uppercase tracking-wider hidden sm:inline">Quy cách:</span>
<select class="bg-surface-container-lowest text-on-surface font-body-sm px-3 py-1.5 rounded focus:outline-none focus:bg-surface-container-high transition-colors border border-outline-variant/40" id="packagingFilter">
<option value="all">Toàn bộ quy cách bao bì</option>
<option value="keg20">Keg Inox 20 Lít</option>
<option value="can24">Thùng 24 Lon (330ml / 250ml)</option>
<option value="bottle24">Thùng 24 Chai (330ml / 500ml)</option>
</select>
</div>
</div>
</section>
<!-- Product Catalog Grid -->
<section class="w-full px-gutter-mobile md:px-margin-tablet lg:px-margin py-space-xl">
<div class="max-w-7xl mx-auto">
<div class="flex items-center justify-between mb-space-md">
<p class="font-label-md text-on-surface-variant uppercase tracking-wider">
          Hiển thị <span class="font-bold text-primary" id="displayedCount">6</span> mã sản phẩm
        </p>
<div class="flex items-center gap-space-xs text-on-surface-variant font-label-sm">
<span class="w-2.5 h-2.5 rounded-full bg-surface-tint"></span>
<span class="">Kho Tổng Long Phước, Long Thành</span>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg" id="productGrid">
{products.map((p) => <ProductCard {...p} />)}
<div id="productEmpty" class="hidden md:col-span-2 lg:col-span-3 p-space-xl text-center bg-surface-container-low rounded border border-outline-variant/40">
<span class="material-symbols-outlined text-[32px] text-on-surface-variant">search_off</span>
<p class="font-label-lg text-primary mt-space-xs">Không có sản phẩm phù hợp bộ lọc</p>
<p class="font-body-sm text-on-surface-variant">Hãy thử chọn quy cách hoặc nhóm sản phẩm khác.</p>
</div>
</div>
</div>
</section>
<!-- Commercial Wholesale Policy & MOQ Terms -->
<section class="w-full bg-surface-container-low px-gutter-mobile md:px-margin-tablet lg:px-margin py-space-xl" id="chinh-sach-b2b">
<div class="max-w-7xl mx-auto flex flex-col gap-space-lg">
<div class="flex flex-col gap-space-xs max-w-2xl">
<span class="font-label-md text-secondary tracking-widest uppercase font-bold">Chính Sách Bán Buôn &amp; Hạn Mức Thương Mại</span>
<h2 class="font-headline-lg text-primary tracking-tight">Kỷ luật hợp đồng và quy trình yêu cầu đặt hàng</h2>
<p class="font-body-md text-on-surface-variant">
          Long Thanh Beer Company Limited (LTB) áp dụng bảng cơ chế phân phối minh bạch, cam kết hỗ trợ toàn diện về thiết bị chiết rót, chứng từ thuế và công nợ định kỳ.
        </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
<!-- Policy 1 -->
<div class="p-space-lg bg-surface-container-lowest rounded flex flex-col gap-space-sm border border-outline-variant/40">
<div class="w-12 h-12 rounded bg-primary-container text-on-primary flex items-center justify-center">
<span class="material-symbols-outlined text-[24px]">layers</span>
</div>
<h3 class="font-headline-sm text-primary font-bold">Quy Chuẩn MOQ Linh Hoạt</h3>
<p class="font-body-md text-on-surface-variant">
            Đơn hàng khởi điểm tối thiểu chỉ từ <strong class="text-on-surface font-semibold">10 thùng tiêu chuẩn</strong> hoặc <strong class="text-on-surface font-semibold">02 Keg tươi 20L</strong>. Hỗ trợ ghép chuyến đa dạng mã hàng cho đơn vị lần đầu thử nghiệm thị trường.
          </p>
<div class="mt-auto pt-space-xs text-on-surface-variant font-body-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-primary">check_circle</span>
<span class="">Hỗ trợ cấp vòi rót &amp; bình khí CO2</span>
</div>
</div>
<!-- Policy 2 -->
<div class="p-space-lg bg-surface-container-lowest rounded flex flex-col gap-space-sm border border-outline-variant/40">
<div class="w-12 h-12 rounded bg-secondary-fixed text-on-secondary-fixed-variant flex items-center justify-center">
<span class="material-symbols-outlined text-[24px]">trending_up</span>
</div>
<h3 class="font-headline-sm text-primary font-bold">Báo Giá Theo Từng Yêu Cầu</h3>
<p class="font-body-md text-on-surface-variant">
            Giá bán buôn không niêm yết công khai. Mỗi yêu cầu được nhân viên kinh doanh LTB phản hồi báo giá riêng sau khi tài khoản đại lý được duyệt.
          </p>
<div class="mt-auto pt-space-xs text-on-surface-variant font-body-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-secondary">check_circle</span>
<span class="">Hồ sơ đại lý được thẩm định trước khi kích hoạt</span>
</div>
</div>
<!-- Policy 3 -->
<div class="p-space-lg bg-surface-container-lowest rounded flex flex-col gap-space-sm border border-outline-variant/40">
<div class="w-12 h-12 rounded bg-primary-fixed text-on-primary-fixed flex items-center justify-center">
<span class="material-symbols-outlined text-[24px]">description</span>
</div>
<h3 class="font-headline-sm text-primary font-bold">Pháp Lý &amp; Hóa Đơn VAT Điện Tử</h3>
<p class="font-body-md text-on-surface-variant">
            100% chuyến hàng xuất xưởng đều xuất kèm hóa đơn điện tử hợp lệ, giấy kiểm định an toàn vệ sinh thực phẩm (ATTP) và phiếu kiểm nghiệm KCS từng mẻ nấu.
          </p>
<div class="mt-auto pt-space-xs text-on-surface-variant font-body-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-primary">check_circle</span>
<span class="">Mã số thuế: 3603823707 chuẩn hóa</span>
</div>
</div>
</div>
<!-- Quy trình yêu cầu đặt hàng (thay cho bảng chiết khấu — LTB không công khai giá đại lý) -->
<div class="bg-surface-container-lowest rounded border border-outline-variant/40 p-space-lg">
<h3 class="font-headline-sm text-primary font-bold mb-space-md">Vòng đời một yêu cầu đặt hàng</h3>
<ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-space-md font-body-sm text-on-surface-variant">
<li class="flex flex-col gap-space-xs"><OrderStatusBadge status="draft" /><span>Đại lý soạn yêu cầu, chưa gửi.</span></li>
<li class="flex flex-col gap-space-xs"><OrderStatusBadge status="submitted" /><span>Yêu cầu đã gửi tới LTB. Đại lý vẫn có thể sửa hoặc hủy.</span></li>
<li class="flex flex-col gap-space-xs"><OrderStatusBadge status="under_review" /><span>Nhân viên kinh doanh LTB đang xem xét.</span></li>
<li class="flex flex-col gap-space-xs"><OrderStatusBadge status="revision_requested" /><span>LTB đề nghị chỉnh sửa; đại lý cập nhật và gửi lại.</span></li>
<li class="flex flex-col gap-space-xs"><OrderStatusBadge status="confirmed" /><span>Chỉ khi LTB xác nhận chính thức. Sau đó không thể sửa/hủy trên cổng.</span></li>
</ol>
<p class="font-body-sm text-on-surface-variant mt-space-md">Giá bán buôn không được công khai trên website. Tài khoản đại lý cần được LTB duyệt và kích hoạt trước khi gửi yêu cầu đặt hàng.</p>
</div>
</div>
</section>
<!-- Interactive Detail Modal (Sample Item Inspection) -->
<div class="fixed inset-0 z-50 bg-inverse-surface/60 hidden items-center justify-center p-gutter-mobile" id="specModal">
<div class="bg-surface-container-lowest max-w-2xl w-full rounded overflow-hidden flex flex-col border border-outline-variant/40">
<!-- Modal Header -->
<div class="px-space-lg py-space-md bg-primary text-on-primary flex items-center justify-between">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-[20px] text-secondary">article</span>
<span class="font-label-lg font-bold uppercase tracking-wider" id="modalSku">LTB-KEG-AMB01</span>
</div>
<button type="button" class="text-on-primary/70 hover:text-on-primary" data-close-modal aria-label="Đóng">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<!-- Modal Body -->
<div class="p-space-lg flex flex-col gap-space-md">
<div>
<h3 class="font-headline-md text-primary font-bold" id="modalTitle">LTB Craft Amber Lager — Keg 20L</h3>
<p class="font-body-sm text-on-surface-variant mt-1" id="modalDesc">
            Quy trình lên men chìm truyền thống nhiệt độ thấp trong 28 ngày. Mạch nha Munich &amp; Caramel cao cấp nhập khẩu từ Bỉ kết hợp nguồn nước tinh lọc địa phương Long Thành.
          </p>
</div>
<!-- Spec Data Table -->
<div class="bg-surface-container-low rounded p-space-md flex flex-col gap-2 font-body-sm">
<div class="grid grid-cols-2 py-1">
<span class="text-on-surface-variant">Độ cồn thực tế (% ABV):</span>
<span class="font-semibold text-on-surface">5.2% ± 0.2</span>
</div>
<div class="grid grid-cols-2 py-1">
<span class="text-on-surface-variant">Chỉ số độ đắng (IBU):</span>
<span class="font-semibold text-on-surface">22 IBU (Êm dịu)</span>
</div>
<div class="grid grid-cols-2 py-1">
<span class="text-on-surface-variant">Quy cách van kết nối:</span>
<span class="font-semibold text-on-surface">A-Type (Chuẩn Phổ Thông Toàn Cầu)</span>
</div>
<div class="grid grid-cols-2 py-1">
<span class="text-on-surface-variant">Thời hạn sử dụng:</span>
<span class="font-semibold text-on-surface">60 ngày trong điều kiện lạnh 2-4°C</span>
</div>
<div class="grid grid-cols-2 py-1">
<span class="text-on-surface-variant">Mã số hồ sơ tự công bố:</span>
<span class="font-semibold text-on-surface">LTB/CBCL-2024/01</span>
</div>
</div>
<div class="p-space-sm bg-surface-container rounded text-on-surface-variant font-body-sm flex items-start gap-2">
<span class="material-symbols-outlined text-[18px] text-secondary mt-0.5">verified_user</span>
<span class="">Bảo hành hoàn đổi 1:1 miễn phí nếu Keg bị rò khí áp suất hoặc biến chất do quá trình lưu vận chuyển.</span>
</div>
</div>
<!-- Modal Footer -->
<div class="px-space-lg py-space-sm bg-surface-container flex justify-end gap-space-xs">
<button type="button" class="px-space-md py-2 rounded bg-surface-container-high text-on-surface font-label-md" data-close-modal>Đóng lại</button>
<a id="modalQuote" class="px-space-md py-2 rounded bg-secondary text-on-secondary hover:bg-on-secondary-container font-label-md flex items-center gap-1 border border-outline-variant/40" href="/lien-he#yeu-cau-bao-gia">
<span class="material-symbols-outlined text-[16px]">request_quote</span>
<span class="">Yêu cầu báo giá</span>
</a>
</div>
</div>
</div>
<!-- Bottom Fast Dispatch & Inquiry Callout Bar -->
<section class="w-full bg-primary text-on-primary px-gutter-mobile md:px-margin-tablet lg:px-margin py-space-xl">
<div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-space-lg">
<div class="flex flex-col gap-space-xs text-center lg:text-left max-w-2xl">
<span class="font-label-sm text-secondary tracking-widest uppercase font-bold">Hỗ Trợ Đại Lý Kỹ Thuật &amp; Báo Giá Dự Án</span>
<h2 class="font-headline-lg tracking-tight">Cần thử mẫu chất lượng (Sampling) hoặc đặt mẻ gia công OEM riêng?</h2>
<p class="font-body-md text-surface-tint">
          Đội ngũ đại diện thương mại tại Long Thành sẵn sàng gửi mẫu thử đến địa chỉ kinh doanh của quý đối tác trong vòng 48 giờ làm việc.
        </p>
</div>
<div class="flex flex-col sm:flex-row items-center gap-space-sm w-full lg:w-auto">
<a class="w-full sm:w-auto px-space-lg py-3 rounded bg-secondary text-on-secondary hover:bg-on-secondary-container font-label-lg transition-colors flex items-center justify-center gap-space-xs border border-outline-variant/40" href="tel:0899447181">
<span class="material-symbols-outlined text-[20px]">call</span>
<span class="">Hotline: 0899 447 181</span>
</a>
<a class="w-full sm:w-auto px-space-md py-3 rounded bg-primary-container hover:bg-primary-container/80 text-on-primary font-label-lg transition-colors flex items-center justify-center gap-space-xs border border-outline-variant/40" href="/lien-he#yeu-cau-bao-gia">
<span class="material-symbols-outlined text-[20px]">mark_email_read</span>
<span class="">Gửi yêu cầu nhận mẫu</span>
</a>
</div>
</div>
</section>
</div>
</main>
<script is:inline define:vars={{ productDataMap }}>
  const catButtons = document.querySelectorAll('.cat-pill');
  const packSelect = document.getElementById('packagingFilter');
  const productCards = document.querySelectorAll('.product-item');
  const countDisplay = document.getElementById('displayedCount');
  const emptyState = document.getElementById('productEmpty');

  function applyFilters() {
    const activeCatBtn = document.querySelector('.cat-pill.active');
    const selectedCategory = activeCatBtn ? activeCatBtn.dataset.category : 'all';
    const selectedPackaging = packSelect ? packSelect.value : 'all';
    let visibleCount = 0;
    productCards.forEach((card) => {
      const ok = (selectedCategory === 'all' || card.dataset.category === selectedCategory) &&
                 (selectedPackaging === 'all' || card.dataset.pack === selectedPackaging);
      card.style.display = ok ? 'flex' : 'none';
      if (ok) visibleCount++;
    });
    if (countDisplay) countDisplay.textContent = visibleCount;
    if (emptyState) emptyState.classList.toggle('hidden', visibleCount !== 0);
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => {
        b.classList.remove('active', 'bg-primary', 'text-on-primary');
        b.classList.add('bg-surface-container-lowest', 'text-on-surface');
      });
      btn.classList.add('active', 'bg-primary', 'text-on-primary');
      btn.classList.remove('bg-surface-container-lowest', 'text-on-surface');
      applyFilters();
    });
  });
  if (packSelect) packSelect.addEventListener('change', applyFilters);

  const modal = document.getElementById('specModal');
  const modalSku = document.getElementById('modalSku');
  const modalTitle = document.getElementById('modalTitle');
  const modalDesc = document.getElementById('modalDesc');
  const modalQuote = document.getElementById('modalQuote');

  function openModal(sku) {
    if (!modal) return;
    const d = productDataMap[sku];
    if (modalSku) modalSku.textContent = sku;
    if (d && modalTitle) modalTitle.textContent = d.title;
    if (d && modalDesc) modalDesc.textContent = d.desc;
    if (modalQuote) modalQuote.setAttribute('href', '/lien-he?sku=' + encodeURIComponent(sku) + '#yeu-cau-bao-gia');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
  document.querySelectorAll('[data-spec-sku]').forEach((b) => b.addEventListener('click', () => openModal(b.dataset.specSku)));
  document.querySelectorAll('[data-close-modal]').forEach((b) => b.addEventListener('click', closeModal));
  if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
</PublicLayout>
