---
import DealerLayout from '../../layouts/DealerLayout.astro';
---
<DealerLayout title="LTB - Cổng Đại Lý B2B | Bia Long Thành" bodyClass="bg-surface font-body-md text-body-md text-on-surface antialiased" active="don-dat-hang-cua-toi">
<main class="w-full pt-20 bg-surface min-h-[calc(100vh-200px)]"><div class="flex flex-col w-full">
<!-- Top Context & Quick Metrics Bar -->
<section class="w-full bg-surface-container-high px-gutter py-space-md">
<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
<div class="flex flex-col gap-space-xs">
<div class="flex items-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm">
<span>CỔNG ĐẠI LÝ B2B</span>
<span class="text-outline-variant">/</span>
<span>QUẢN LÝ THƯƠNG MẠI</span>
<span class="text-outline-variant">/</span>
<span class="text-primary font-semibold">THEO DÕI ĐƠN HÀNG STATE MACHINE V1.2</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Quản Lý Yêu Cầu Đặt Hàng Của Tôi</h1>
