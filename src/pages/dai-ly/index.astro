<input class="w-full h-10 pl-9 pr-3 rounded bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest" placeholder="Tìm theo Mã Đơn (VD: LTB-ORD-2025-089)..." type="text" value=""/>
