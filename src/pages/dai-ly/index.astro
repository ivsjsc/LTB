</div>
<span class="font-body-sm text-body-sm text-on-surface-variant">Sẵn sàng xuất kho theo kế hoạch</span>
</div>
</div>
<!-- Filters, Status Tabs & Search Tool -->
<div class="bg-surface-container-lowest p-space-md rounded flex flex-col gap-space-md border border-outline-variant/40">
<!-- Status Tabs (State Machine v1.2) -->
<div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs no-scrollbar">
<button class="px-space-md py-space-sm rounded font-label-md text-label-md bg-primary text-on-primary flex items-center gap-space-xs whitespace-nowrap border border-outline-variant/40">
<span>Tất cả</span>
<span class="bg-primary-container text-on-primary-fixed px-1.5 py-0.5 rounded-full text-[10px]">12</span>
</button>
<button class="px-space-md py-space-sm rounded font-label-md text-label-md bg-surface-container hover:bg-surface-container-high text-on-surface-variant flex items-center gap-space-xs whitespace-nowrap transition-colors">
