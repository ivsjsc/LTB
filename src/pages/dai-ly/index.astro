<option>Tất cả kênh nhận: Xe đại lý / Xe nhà máy</option>
<option>Giao tận kho đại lý (Xe LTB)</option>
<option>Đại lý nhận tại Nhà máy Long Thành</option>
</select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-outline text-[18px]">expand_more</span>
</div>
</div>
<div class="md:col-span-2 flex items-center gap-space-xs">
<button class="w-full h-10 bg-surface-container hover:bg-surface-container-high rounded font-label-md text-label-md text-on-surface flex items-center justify-center gap-space-xs transition-colors">
<span class="material-symbols-outlined text-[16px]">filter_alt</span>
<span>Đặt lại lọc</span>
</button>
</div>
</div>
</div>
<!-- B2B Order Lifecycle Data Table -->
<div class="bg-surface-container-lowest rounded overflow-hidden flex flex-col border border-outline-variant/40">
