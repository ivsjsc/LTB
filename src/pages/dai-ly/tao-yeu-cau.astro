<script is:inline>
    function adjustQty(inputId, delta) {
      const input = document.getElementById(inputId);
      if (!input) return;
      let val = parseInt(input.value || '0', 10);
      val = Math.max(0, val + delta);
      input.value = val;
      updateSummary();
    }

    function updateSummary() {
      const kegAmb = parseInt(document.getElementById('qty-keg-amb')?.value || '0', 10);
      const kegWht = parseInt(document.getElementById('qty-keg-wht')?.value || '0', 10);
      const canPil = parseInt(document.getElementById('qty-can-pil')?.value || '0', 10);
      const btlStt = parseInt(document.getElementById('qty-btl-stt')?.value || '0', 10);
      const wtrIon = parseInt(document.getElementById('qty-wtr-ion')?.value || '0', 10);

      const totalKegs = kegAmb + kegWht;
      const totalPackages = canPil + btlStt + wtrIon;

      const kegEl = document.getElementById('summary-keg');
      const pkgEl = document.getElementById('summary-pkg');

      if (kegEl) kegEl.innerText = totalKegs + ' Keg 20L';
      if (pkgEl) pkgEl.innerText = totalPackages + ' Thùng';
    }

    function submitRequest() {
      const check = document.getElementById('commitment-check');
      if (!check || !check.checked) {
        alert('Vui lòng chọn xác nhận vào ô cam kết trước khi gửi yêu cầu đặt hàng thương mại.');
        return;
      }
      const btn = document.getElementById('btn-submit');
      if (btn) {
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span><span>Đang Chuyển Yêu Cầu...</span>';
        btn.classList.add('opacity-80', 'pointer-events-none');
      }

      setTimeout(() => {
        alert('Thành công! Yêu cầu đặt hàng sỉ #PR-2024-8849 đã được chuyển đến Nhân viên Kinh doanh phụ trách đại lý NPP Đồ Uống Miền Đông. SLA xác nhận trong vòng 60 phút.');
        if (btn) {
          btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check_circle</span><span>Đã Tiếp Nhận Thành Công</span>';
          btn.classList.remove('bg-secondary', 'hover:bg-secondary/90');
          btn.classList.add('bg-primary-container', 'text-on-primary-fixed');
        }
      }, 1000);
    }

    function saveDraft() {
      alert('Đã lưu bản nháp yêu cầu đặt hàng tạm thời trên hệ thống nội bộ của đại lý.');
    }
  </script>
