<script is:inline>
  function switchState(stateName) {
    // Hide all panels
    const panels = document.querySelectorAll('.state-panel');
    panels.forEach(p => p.classList.add('hidden'));

    // Reset tab button styles
    const tabButtons = document.querySelectorAll('.tab-btn');
    tabButtons.forEach(btn => {
      btn.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
      btn.classList.add('text-on-surface-variant');
    });

    // Show chosen panel
    const targetPanel = document.getElementById('panel-' + stateName);
    if (targetPanel) {
      targetPanel.classList.remove('hidden');
    }

    // Highlight chosen tab
    const targetTab = document.getElementById('tab-' + stateName);
    if (targetTab) {
      targetTab.classList.remove('text-on-surface-variant');
      targetTab.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
    }
  }

  function togglePasswordVisibility() {
    const pwdInput = document.getElementById('dealer-pwd');
    const eyeIcon = document.getElementById('eye-icon');
    if (!pwdInput || !eyeIcon) return;

    if (pwdInput.type === 'password') {
      pwdInput.type = 'text';
      eyeIcon.textContent = 'visibility_off';
    } else {
      pwdInput.type = 'password';
      eyeIcon.textContent = 'visibility';
    }
  }
</script>
</BaseLayout>
