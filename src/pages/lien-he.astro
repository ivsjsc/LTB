---
import LeadForm from '../components/LeadForm.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="Long Thanh Beer (LTB) - Cổng Phân Phối Thương Mại B2B" bodyClass="bg-background font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-on-secondary-container" active="lien-he">
<main class="w-full pt-20 bg-background"><div class="flex flex-col w-full">
<!-- SECTION 1: HEADER & STATS TICKER -->
<section class="relative w-full bg-surface-container-low py-space-xl overflow-hidden">
<div class="w-full px-gutter-mobile md:px-margin-tablet lg:px-margin">
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
<div class="max-w-3xl">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-primary text-on-primary mb-space-sm border border-outline-variant/40">
<span class="material-symbols-outlined text-[16px] text-secondary-container">verified_user</span>
<span class="font-label-sm uppercase tracking-wider">Cổng Xác Minh Pháp Lý &amp; Giao Dịch Doanh Nghiệp</span>
</div>
<h1 class="font-display-lg text-primary tracking-tight">
            Liên Hệ Trực Tiếp Phòng Thương Mại B2B
          </h1>
<p class="font-body-lg text-on-surface-variant mt-space-sm max-w-2xl">
            Kết nối nhanh chóng với ban điều hành và đội ngũ phụ trách phát triển thị trường của Long Thanh Beer Company Limited. Mọi giao dịch buôn, hợp đồng cung ứng đều được xác thực pháp lý minh bạch.
          </p>
</div>
<div class="flex flex-col sm:flex-row gap-space-sm shrink-0">
<a class="inline-flex items-center justify-center gap-2 px-space-lg py-3 rounded bg-secondary text-on-secondary font-label-lg hover:opacity-95 transition-all border border-outline-variant/40" href="tel:0899447181">
<span class="material-symbols-outlined text-[18px]">call</span>
<span>Gọi Hotline: 0899 447 181</span>
</a>
<a class="inline-flex items-center justify-center gap-2 px-space-lg py-3 rounded bg-surface-container-highest text-primary font-label-lg hover:bg-surface-dim transition-colors" href="#yeu-cau-bao-gia">
<span class="material-symbols-outlined text-[18px]">mail</span>
<span>Gửi Hồ Sơ Yêu Cầu</span>
</a>
</div>
</div>
<!-- Quick KPI Strip -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-space-md mt-space-xl pt-space-lg">
<div class="flex flex-col p-space-md rounded bg-surface border border-outline-variant/40">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Phản hồi Báo Giá</span>
<span class="font-headline-md text-primary mt-1 font-bold">Dưới 60 phút</span>
<span class="font-body-sm text-on-surface-variant">Giờ hành chính (T2 - T7)</span>
</div>
<div class="flex flex-col p-space-md rounded bg-surface border border-outline-variant/40">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Mạng Lưới Vận Tải</span>
<span class="font-headline-md text-primary mt-1 font-bold">24h - 48h</span>
<span class="font-body-sm text-on-surface-variant">Toàn bộ Đông Nam Bộ</span>
</div>
<div class="flex flex-col p-space-md rounded bg-surface border border-outline-variant/40">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">KCS &amp; Kiểm Định</span>
<span class="font-headline-md text-primary mt-1 font-bold">100% Lô Hàng</span>
<span class="font-body-sm text-on-surface-variant">Phiếu test &amp; CO/CQ kèm theo</span>
</div>
<div class="flex flex-col p-space-md rounded bg-surface border border-outline-variant/40">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Hỗ Trợ Kỹ Thuật Keg</span>
<span class="font-headline-md text-primary mt-1 font-bold">Trực 24/7</span>
<span class="font-body-sm text-on-surface-variant">Bảo dưỡng giàn rót bia tươi</span>
</div>
</div>
</div>
</section>
<!-- SECTION 2: VERIFIED CORPORATE PROFILE & INQUIRY FORM (SPLIT EDITORIAL GRID) -->
<section class="w-full py-space-xl bg-surface">
<div class="w-full px-gutter-mobile md:px-margin-tablet lg:px-margin">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
<!-- Left: Legal Ledger / Corporate Profile Card -->
<div class="lg:col-span-5 flex flex-col gap-space-lg">
<div class="bg-primary text-on-primary p-space-lg rounded relative overflow-hidden border border-outline-variant/40">
<div class="flex items-center justify-between gap-space-md pb-space-md mb-space-md">
<div>
<span class="font-label-sm text-secondary-container uppercase tracking-widest font-semibold block">Hồ Sơ Doanh Nghiệp Hợp Pháp</span>
<span class="font-headline-sm text-on-primary font-bold">ĐĂNG KÝ KINH DOANH CHÍNH THỨC</span>
</div>
<span class="material-symbols-outlined text-secondary-container text-3xl">verified</span>
</div>
<!-- Profile Data Rows -->
<div class="flex flex-col gap-space-md text-on-primary/90">
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Tên tiếng Việt</span>
<span class="font-label-lg text-on-primary font-bold block mt-0.5">CÔNG TY TNHH BIA LONG THÀNH</span>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Tên giao dịch quốc tế</span>
<span class="font-body-md text-on-primary font-medium block mt-0.5">LONG THANH BEER CO., LTD</span>
</div>
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Viết tắt giao dịch</span>
<span class="font-body-md text-on-primary font-medium block mt-0.5">LTB CO., LTD</span>
</div>
</div>
<div class="bg-primary-container p-space-md rounded flex items-center justify-between gap-space-sm">
<div>
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Mã số thuế doanh nghiệp (MST)</span>
<span class="font-headline-sm text-secondary-container font-mono tracking-wider font-bold">3603823707</span>
</div>
<span class="font-label-sm px-2.5 py-1 bg-surface/10 rounded text-on-primary text-right">Cấp bởi SKH&amp;ĐT Đồng Nai</span>
</div>
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Đại diện pháp luật &amp; Điều hành</span>
<div class="flex items-center gap-space-sm mt-1">
<span class="material-symbols-outlined text-secondary-container text-[20px]">badge</span>
<span class="font-label-lg text-on-primary font-bold">HOÀNG XUÂN DŨNG</span>
<span class="font-body-sm text-on-primary-container">— Giám Đốc Điều Hành</span>
</div>
</div>
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Trụ sở chính &amp; Tổng kho</span>
<p class="font-body-md text-on-primary mt-1" id="hq-address">
                  1401/2, Tổ 17, Ấp Phước Hòa, Xã Long Phước, Huyện Long Thành, Tỉnh Đồng Nai, Việt Nam
                </p>
<div class="mt-space-sm flex items-center gap-space-sm">
<button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-surface/15 hover:bg-surface/25 text-on-primary font-label-sm transition-colors cursor-pointer" id="copy-address-btn">
<span class="material-symbols-outlined text-[16px]" id="copy-icon">content_copy</span>
<span id="copy-text">Sao chép địa chỉ</span>
</button>
<span class="font-label-sm text-on-primary-container">Khu công nghiệp &amp; Cảng kết nối</span>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Hotline Điều Phối B2B</span>
<a class="font-headline-sm text-secondary-container font-bold hover:underline block mt-0.5" href="tel:0899447181">0899 447 181</a>
</div>
<div class="bg-primary-container p-space-md rounded">
<span class="font-label-sm text-on-primary-container uppercase tracking-wider block">Giờ Làm Việc</span>
<span class="font-body-md text-on-primary font-medium block mt-0.5">T2 - T7: 08:00 - 17:30</span>
<span class="font-label-sm text-secondary-container block mt-0.5">Cấp bia khẩn 24/7</span>
</div>
</div>
</div>
</div>
<!-- Legal Attestation Box -->
<div class="p-space-md rounded bg-surface-container-low flex items-start gap-space-sm border border-outline-variant/40">
<span class="material-symbols-outlined text-secondary text-2xl shrink-0 mt-0.5">policy</span>
<div class="flex flex-col">
<span class="font-label-md text-primary font-bold">Hồ Sơ Đăng Ký Thương Mại Công Khai</span>
<p class="font-body-sm text-on-surface-variant mt-1">
                Doanh nghiệp chịu hoàn toàn trách nhiệm pháp lý trước pháp luật Nước Cộng Hòa Xã Hội Chủ Nghĩa Việt Nam về tính xác thực của thông tin thuế, tiêu chuẩn kiểm nghiệm an toàn thực phẩm lô hàng và nguồn gốc nguyên liệu mạch nha, hoa bia.
              </p>
</div>
</div>
</div>
<!-- Right: Enterprise Inquiry Form -->
<div class="lg:col-span-7 flex flex-col" id="yeu-cau-bao-gia">
<div class="bg-surface-container-lowest p-space-xl rounded border border-outline-variant/40">
<div class="flex flex-col pb-space-md mb-space-lg">
<span class="font-label-sm text-secondary font-bold uppercase tracking-wider">Tiếp nhận thông tin đối tác</span>
<h2 class="font-headline-lg text-primary tracking-tight mt-1">Bản Yêu Cầu Thương Mại &amp; Yêu Cầu Báo Giá</h2>
<p class="font-body-md text-on-surface-variant mt-1">
                Vui lòng điền đầy đủ thông tin bên dưới. Chuyên viên quản lý khu vực của LTB sẽ liên hệ phản hồi yêu cầu của quý đối tác.
              </p>
</div>
<LeadForm id="b2b-lead" submitLabel="Gửi yêu cầu cho Phòng Kinh Doanh" topics={[
{ value: 'dai-ly-si', label: 'Đăng ký làm Đại lý phân phối / Nhà bán buôn cấp 1' },
{ value: 'bao-gia', label: 'Yêu cầu báo giá bia tươi Keg 20L & hỗ trợ giàn lạnh' },
{ value: 'gia-cong-oem', label: 'Gia công bia nhãn riêng (OEM / Contract Brewing)' },
{ value: 'hoa-don-vat', label: 'Đối soát công nợ & xuất hóa đơn VAT điện tử' },
{ value: 'khac', label: 'Nội dung hợp tác khác' },
]} />
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 3: LOCATION SCHEMATIC MAP & LOGISTICS CORRIDOR -->
<section class="w-full py-space-xl bg-surface-container-low">
<div class="w-full px-gutter-mobile md:px-margin-tablet lg:px-margin">
<div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-space-md mb-space-lg">
<div>
<span class="font-label-sm text-secondary font-bold uppercase tracking-wider block">Tâm Điểm Hậu Cần Long Thành</span>
<h2 class="font-headline-xl text-primary tracking-tight mt-1">Vị Trí Trụ Sở &amp; Cụm Kho Tổng Phân Phối</h2>
</div>
<div class="flex items-center gap-2 px-space-md py-2 rounded bg-surface text-primary border border-outline-variant/40">
<span class="material-symbols-outlined text-surface-tint">local_shipping</span>
<span class="font-label-md font-semibold">Bán kính điều phối: TP.HCM - Đồng Nai - Bà Rịa Vũng Tàu - Bình Dương</span>
</div>
</div>
<!-- Bento Grid for Map & Hub Capabilities -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
<!-- Interactive schematic styled map container -->
<div class="lg:col-span-8 flex flex-col rounded bg-surface overflow-hidden relative border border-outline-variant/40">
<div class="w-full h-96 bg-cover bg-center relative" data-location="Long Phuoc, Long Thanh, Dong Nai, Vietnam" style="background-image: url('/images/stitch/d010547d27.png')">
<!-- Scrim gradient for contrast -->
<div class="absolute inset-0 bg-primary/30"></div>
<!-- Map floating pinpoint box -->
<div class="absolute bottom-6 left-6 right-6 md:right-auto md:max-w-md bg-surface p-space-md rounded text-on-surface border border-outline-variant/40">
<div class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-secondary text-3xl shrink-0 mt-0.5">location_on</span>
<div class="flex flex-col">
<span class="font-label-lg text-primary font-bold">Khu Vực Phước Hòa, Long Phước</span>
<p class="font-body-sm text-on-surface-variant mt-0.5">
                    1401/2, Tổ 17, Xã Long Phước, Huyện Long Thành, Tỉnh Đồng Nai. Liền kề trục Quốc lộ 51 và Vành đai Cảng Hàng Không Quốc Tế Long Thành.
                  </p>
<div class="flex items-center gap-2 mt-2 pt-2 text-on-surface-variant font-label-sm">
<span class="material-symbols-outlined text-[16px] text-surface-tint">route</span>
<span>Cách Cụm Cảng Cái Mép 18km • Cách Cao tốc Long Thành 12km</span>
</div>
</div>
</div>
</div>
</div>
<!-- Bottom bar of map -->
<div class="p-space-md bg-surface-container-high flex flex-wrap items-center justify-between gap-space-sm font-body-sm">
<span class="text-on-surface-variant flex items-center gap-1.5">
<span class="w-2.5 h-2.5 rounded-full bg-surface-tint inline-block animate-pulse"></span>
              Kho vận xuất nhập khẩu vận hành liên tục 24/7
            </span>
<a class="font-label-md text-primary hover:text-secondary flex items-center gap-1" href="https://maps.google.com" rel="noopener noreferrer" target="_blank">
<span>Mở Google Maps Điều Hướng Xe Tải</span>
<span class="material-symbols-outlined text-[16px]">open_in_new</span>
</a>
</div>
</div>
<!-- Right Side: Logistic Guarantees -->
<div class="lg:col-span-4 flex flex-col gap-space-md">
<div class="p-space-lg rounded bg-surface flex flex-col justify-between border border-outline-variant/40">
<div>
<div class="w-10 h-10 rounded bg-primary text-on-primary flex items-center justify-center mb-space-sm">
<span class="material-symbols-outlined text-[22px]">timer</span>
</div>
<h3 class="font-headline-sm text-primary font-bold">Cam Kết Giao Hàng 24h - 48h</h3>
<p class="font-body-sm text-on-surface-variant mt-1.5">
                Nhờ vị thế trọng yếu tại tam giác công nghiệp Long Thành - Nhơn Trạch - Biên Hòa, mọi đơn bia keg tươi hoặc két lon/chai đều được xếp dỡ và vận chuyển đến điểm bán trong vòng 24 đến 48 giờ.
              </p>
</div>
<div class="mt-space-md pt-space-md">
<div class="flex items-center justify-between text-body-sm text-on-surface-variant">
<span>Độ trễ giao hàng 2024:</span>
<span class="font-label-sm text-primary font-bold">&lt; 0.8%</span>
</div>
<div class="w-full bg-surface-container-highest h-1.5 rounded overflow-hidden mt-1.5">
<div class="bg-surface-tint h-full w-[99.2%]"></div>
</div>
</div>
</div>
<div class="p-space-lg rounded bg-surface flex flex-col justify-between border border-outline-variant/40">
<div>
<div class="w-10 h-10 rounded bg-secondary text-on-secondary flex items-center justify-center mb-space-sm">
<span class="material-symbols-outlined text-[22px]">ac_unit</span>
</div>
<h3 class="font-headline-sm text-primary font-bold">Bảo Quản Dây Chuyền Lạnh (Cold-chain)</h3>
<p class="font-body-sm text-on-surface-variant mt-1.5">
                Xe tải chuyên dụng duy trì dải nhiệt tiêu chuẩn 4°C - 8°C đối với dòng bia thủ công và bia tươi Keg, giữ vẹn nguyên tầng hương hoa bia tươi mới khi đến tay quý khách.
              </p>
</div>
<div class="mt-space-md pt-space-md flex items-center gap-2 text-surface-tint font-label-sm">
<span class="material-symbols-outlined text-[18px]">verified</span>
<span>Đạt tiêu chuẩn xuất xưởng ISO &amp; ATTP</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 4: FAST ACTION DIRECT CONTACT CARDS -->
<section class="w-full py-space-xl bg-surface">
<div class="w-full px-gutter-mobile md:px-margin-tablet lg:px-margin">
<div class="text-center max-w-2xl mx-auto mb-space-lg">
<span class="font-label-sm text-secondary font-bold uppercase tracking-wider block">Kênh Hỗ Trợ Chuyên Biệt</span>
<h2 class="font-headline-lg text-primary tracking-tight mt-1">Đường Dây Nóng Theo Từng Bộ Phận</h2>
<p class="font-body-md text-on-surface-variant mt-1">
          Lựa chọn nhánh nghiệp vụ cần giải quyết ngay lập tức để tiết kiệm tối đa thời gian chờ đợi.
        </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
<!-- Card 1 -->
<div class="p-space-lg rounded bg-surface-container-low flex flex-col justify-between hover:bg-surface-container transition-colors border border-outline-variant/40">
<div>
<div class="flex items-center justify-between">
<div class="w-12 h-12 rounded bg-primary text-on-primary flex items-center justify-center">
<span class="material-symbols-outlined text-2xl">storefront</span>
</div>
<span class="font-label-sm px-2 py-0.5 rounded bg-surface-container-highest text-primary font-bold uppercase">Ưu Tiên B2B</span>
</div>
<h3 class="font-headline-sm text-primary font-bold mt-space-md">Tư Vấn Đại Lý Sỉ &amp; Cấp Báo Giá</h3>
<p class="font-body-sm text-on-surface-variant mt-1.5">
              Phụ trách tư vấn hợp đồng đại lý, phạm vi địa bàn theo quận/huyện và chương trình hỗ trợ tiếp thị cho quán.
            </p>
</div>
<div class="mt-space-lg pt-space-md">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider block">Hotline Điều Hành Trực Tiếp</span>
<a class="font-headline-sm text-primary font-bold hover:text-secondary block mt-0.5" href="tel:0899447181">0899 447 181</a>
<div class="mt-space-sm">
<a class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded bg-primary text-on-primary font-label-md hover:bg-primary/90 transition-colors" href="tel:0899447181">
<span class="material-symbols-outlined text-[16px]">phone_in_talk</span>
<span>Kết Nối Ngay</span>
</a>
</div>
</div>
</div>
<!-- Card 2 -->
<div class="p-space-lg rounded bg-surface-container-low flex flex-col justify-between hover:bg-surface-container transition-colors border border-outline-variant/40">
<div>
<div class="flex items-center justify-between">
<div class="w-12 h-12 rounded bg-surface-tint text-on-primary flex items-center justify-center">
<span class="material-symbols-outlined text-2xl">receipt_long</span>
</div>
<span class="font-label-sm px-2 py-0.5 rounded bg-surface-container-highest text-surface-tint font-bold uppercase">Pháp Lý Thuế</span>
</div>
<h3 class="font-headline-sm text-primary font-bold mt-space-md">Đối Soát Hóa Đơn &amp; Kế Toán VAT</h3>
<p class="font-body-sm text-on-surface-variant mt-1.5">
              Phát hành hóa đơn điện tử theo quy chuẩn Thông tư 78/2021/TT-BTC, giải quyết biên bản giao nhận và xác nhận công nợ kỳ kế toán.
            </p>
</div>
<div class="mt-space-lg pt-space-md">
<span class="font-label-sm text-on-surface-variant uppercase tracking-wider block">Kênh Zalo Doanh Nghiệp OA</span>
<span class="font-headline-sm text-primary font-bold block mt-0.5">Zalo: LTB Beer Accounting</span>
<div class="mt-space-sm">
<a class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded bg-surface-container-highest text-primary font-label-md hover:bg-surface-dim transition-colors" href="https://zalo.me" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[16px]">chat</span>
<span>Mở Cửa Sổ Kế Toán</span>
</a>
</div>
</div>
</div>
<!-- Card 3 -->
<div class="p-space-lg rounded bg-surface-container-low flex flex-col justify-between hover:bg-surface-container transition-colors border border-outline-variant/40">
<div>
<div class="flex items-center justify-between">
<div class="w-12 h-12 rounded bg-secondary text-on-secondary flex items-center justify-center">
<span class="material-symbols-outlined text-2xl">build</span>
</div>
<span class="font-label-sm px-2 py-0.5 rounded bg-surface-container-highest text-secondary font-bold uppercase">Kỹ Thuật 24/7</span>
</div>
<h3 class="font-headline-sm text-primary font-bold mt-space-md">Hỗ Trợ Kỹ Thuật Dàn Rót Bia</h3>
<p class="font-body-sm text-on-surface-variant mt-1.5">
              Xử lý sự cố áp suất bình CO2, cân chỉnh độ lạnh giàn rót bia tươi và vệ sinh ống dẫn định kỳ theo quy chuẩn phòng dịch vụ kỹ thuật.
            </p>
