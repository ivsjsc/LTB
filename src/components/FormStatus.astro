---
/** Khối trạng thái success / error dùng chung cho mọi form (script: src/scripts/lead-form.ts). */
import { SITE } from '../lib/site';
interface Props { successTitle?: string; successText?: string }
const {
  successTitle = 'Đã ghi nhận yêu cầu của quý đối tác',
  successText = 'Đây là yêu cầu tiếp nhận, chưa phải xác nhận đơn hàng hay báo giá. LTB sẽ phản hồi qua điện thoại hoặc email.',
} = Astro.props;
---
<div class="hidden p-space-md rounded bg-[#EAF2ED] text-primary-container border border-[rgba(24,59,43,0.2)] items-start gap-space-sm" role="status" data-state="success">
  <span class="material-symbols-outlined text-[24px] shrink-0">mark_email_read</span>
  <div class="flex flex-col">
    <span class="font-label-lg font-bold">{successTitle}</span>
    <span class="font-body-sm">{successText}</span>
  </div>
</div>
<div class="hidden p-space-md rounded bg-error-container text-on-error-container border border-[rgba(186,26,26,0.25)] items-start gap-space-sm" role="alert" data-state="error">
  <span class="material-symbols-outlined text-[24px] shrink-0">error</span>
  <div class="flex flex-col">
    <span class="font-label-lg font-bold">Chưa gửi được yêu cầu</span>
    <span class="font-body-sm">Đã xảy ra lỗi kết nối. Vui lòng thử lại hoặc gọi hotline {SITE.hotline}.</span>
    <button type="button" data-retry class="self-start mt-space-xs font-label-md font-bold underline">Thử lại</button>
  </div>
</div>
