---
import { SITE } from '../lib/site';
---

<footer class="relative bg-[linear-gradient(180deg,#0E0E0E_0%,#1a1a1a_100%)] text-[#9a9585] border-t border-[#B68D2E]/10 overflow-hidden">
  <!-- Subtle noise background -->
  <div
    class="absolute inset-0 opacity-[0.02] pointer-events-none"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'n\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23n)\'/%3E%3C/svg%3E');"
  ></div>

  <!-- Main Footer Body -->
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-8 py-10 lg:py-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.2fr_0.8fr_0.8fr] gap-8 lg:gap-10 relative">
    <!-- Col 1: Brand & Identity -->
    <div class="min-w-0">
      <div class="flex items-start gap-3.5 sm:gap-5">
        <div class="shrink-0">
          <img
            src="/brand/ref-Vn.png"
            alt="LTB - Long Thanh Beer Company Limited"
            class="h-[76px] sm:h-[90px] lg:h-[110px] w-auto object-contain logo-gold-glow"
            style="filter: drop-shadow(0 0 20px rgba(182,141,46,0.5)) drop-shadow(0 4px 12px rgba(182,141,46,0.3));"
          />
        </div>
        <div class="pt-1 min-w-0">
          <div class="font-black text-white tracking-tight text-[15px] sm:text-[17px] leading-tight truncate">
            CÔNG TY TNHH BIA LONG THÀNH
          </div>
          <div class="text-[10.5px] sm:text-[11px] uppercase tracking-[0.16em] font-bold text-[#B68D2E] mt-1 truncate">
            LONG THANH BEER COMPANY LIMITED
          </div>
          <div class="text-[10px] uppercase tracking-[0.14em] font-bold text-[#D4AA4A]/70 mt-1">
            MST 3603823707 • LTB • Vàng #B68D2E
          </div>
        </div>
      </div>

      <p class="mt-4 sm:mt-6 text-[13px] leading-[1.7] max-w-[440px] text-[#c9c2ab]">
        Đơn vị chuyên phân phối bán buôn bia thương mại chính hãng và gia công sản xuất bia craft (bia thủ công OEM/ODM) tại Long Thành — Đồng Nai. Giao nhanh 24/7, hóa đơn VAT đầy đủ theo MST <b class="text-[#D4AA4A]">3603823707</b>.
      </p>

      <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-[#B68D2E]/20 bg-[#15130e] px-3 py-1.5 text-[10px] sm:text-[10.5px] font-bold uppercase tracking-[0.14em] text-[#D4AA4A]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-[#B68D2E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 22 16 8"></path>
          <path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"></path>
        </svg>
        <span>Đã cập nhật đơn vị hành chính sau sáp nhập 2025</span>
      </div>
    </div>

    <!-- Col 2: Legal Invoice Info -->
    <div>
      <div class="text-white font-bold uppercase tracking-[0.14em] text-[12px] flex items-center gap-2">
        <span class="h-1 w-6 rounded-full bg-[#B68D2E]"></span>
        <span>Thông tin xuất hóa đơn</span>
      </div>
      <div class="mt-4 space-y-2 text-[12.5px] leading-[1.6] text-[#b8b29c]">
        <div>
          <b class="text-[#D4AA4A]">Tên:</b> {SITE.legalName}
        </div>
        <div>
          <b class="text-[#D4AA4A]">Tên QT:</b> {SITE.name.toUpperCase()}
        </div>
        <div>
          <b class="text-[#D4AA4A]">Viết tắt:</b> LTB
        </div>
        <div>
          <b class="text-[#D4AA4A]">MST:</b> {SITE.taxCode} - Ngày cấp: {SITE.foundingDate}
        </div>
        <div>
          <b class="text-[#D4AA4A]">Địa chỉ:</b> {SITE.address}
        </div>
        <div>
          <b class="text-[#D4AA4A]">Đại diện:</b> {SITE.representative}
        </div>
        <div>
          <b class="text-[#D4AA4A]">Điện thoại:</b> {SITE.hotlineTel} (Hotline sỉ: {SITE.hotline})
        </div>
      </div>
    </div>

    <!-- Col 3: Industry Codes & Certified Logo -->
    <div>
      <div class="text-white font-bold uppercase tracking-[0.14em] text-[12px] flex items-center gap-2">
        <span class="h-1 w-6 rounded-full bg-[#B68D2E]"></span>
        <span>Lĩnh vực hoạt động</span>
      </div>
      <div class="mt-4 space-y-2 text-[12px] text-[#b8b29c]">
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[#B68D2E]"></span>
          <span>Bán buôn bia thương mại chính hãng</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[#B68D2E]"></span>
          <span>Sản xuất &amp; Gia công bia craft (OEM/ODM)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[#B68D2E]"></span>
          <span>Cung ứng bia tươi Keg 20L cho Bar, Pub</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[#B68D2E]"></span>
          <span>Điều vận &amp; Chuỗi lạnh bảo quản bia</span>
        </div>
      </div>

      <div class="mt-6 text-[11px] leading-[1.6] text-[#6b6b6b]">
        © 2026 LTB - CÔNG TY TNHH BIA LONG THÀNH. Thiết kế premium B2B, tông vàng đồng tin cậy <span class="text-[#B68D2E]">#B68D2E</span> đồng bộ logo.
      </div>
    </div>
  </div>

  <!-- Bottom Copyright & Credit Bar -->
  <div class="border-t border-[#B68D2E]/10 relative">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-8 py-4 lg:h-[56px] flex flex-col lg:flex-row items-center justify-center lg:justify-between gap-2 lg:gap-6">
      <span class="flex items-center gap-2 text-[11px] uppercase tracking-[0.14em] font-bold text-[#9a9585] text-center lg:text-left order-1">
        <img
          src="/brand/ref-fA.png"
          alt=""
          aria-hidden="true"
          class="h-4 w-auto opacity-90 logo-gold-shadow shrink-0"
        />
        <span>© 2026 Công ty TNHH Bia Long Thành. MST 3603823707</span>
      </span>

      <span class="flex items-center justify-center gap-1.5 text-[13px] font-medium tracking-normal normal-case text-[#9ca3af] order-2 text-center">
        <span class="hidden sm:inline opacity-50">—</span>
        <span>Thiết kế bởi</span>
        <a
          href="https://ivstech.store"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#B68D2E] font-bold hover:underline underline-offset-[3px] decoration-[#B68D2E]/70 transition-all"
        >
          IVS Tech
        </a>
        <span class="opacity-60">-</span>
        
      </span>
    </div>
  </div>
</footer>
