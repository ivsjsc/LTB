---
import { SITE } from '../lib/site';

interface Props {
  active?: string;
}

const { active = 'trang-chu' } = Astro.props;

const nav = [
  { key: 'trang-chu', label: 'Trang chủ', href: '/#trang-chu' },
  { key: 'gioi-thieu', label: 'Giới thiệu', href: '/#gioi-thieu' },
  { key: 'san-pham', label: 'Sản phẩm', href: '/#san-pham' },
  { key: 'nang-luc', label: 'Năng lực', href: '/#nang-luc' },
  { key: 'lien-he', label: 'Liên hệ', href: '/#lien-he' },
];
---

<header class="fixed left-0 right-0 top-0 z-50 bg-white/95 backdrop-blur-md border-b border-[#ece6d3] shadow-[0_2px_24px_rgba(182,141,46,0.06)] transition-all duration-300">
  <div class="mx-auto max-w-[1240px] px-3.5 sm:px-6 lg:px-8 h-[68px] sm:h-[72px] lg:h-[76px] flex items-center justify-between">
    <!-- Brand Info -->
    <a href="/#trang-chu" class="flex items-center gap-2.5 sm:gap-3 min-w-0 group" aria-label="Bia Long Thành — Trang chủ">
      <div class="relative flex items-center justify-center rounded-[12px] sm:rounded-[14px] border border-transparent group-hover:border-[#B68D2E]/40 bg-white p-1 sm:px-2 sm:py-1 transition-all duration-300 shrink-0 shadow-sm">
        <img
          src="/brand/ref-Vn.png"
          alt="LTB - Long Thanh Beer"
          class="h-[36px] sm:h-[42px] lg:h-[48px] w-auto object-contain object-left logo-gold-shadow logo-hover"
          style="image-rendering: -webkit-optimize-contrast;"
        />
      </div>
      <div class="leading-tight min-w-0">
        <div class="text-[10px] sm:text-[11px] lg:text-[12px] uppercase tracking-[0.16em] sm:tracking-[0.18em] font-extrabold text-[#B68D2E] truncate">
          LONG THANH BEER
        </div>
        <div class="text-[9px] text-[#8C6B1F] tracking-wide font-medium hidden xs:block sm:block">
          CÔNG TY TNHH BIA LONG THÀNH
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-7" aria-label="Điều hướng chính">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.key ? 'page' : undefined}
          class={`text-[13px] font-semibold tracking-wide uppercase transition relative py-1.5 ${
            active === item.key
              ? 'text-[#B68D2E]'
              : 'text-[#1a1a1a] opacity-80 hover:opacity-100 hover:text-[#B68D2E]'
          }`}
        >
          <span>{item.label}</span>
          {active === item.key && (
            <span class="absolute bottom-0 left-0 right-0 h-[2.5px] rounded-full bg-[#B68D2E]"></span>
          )}
        </a>
      ))}
    </nav>

    <!-- Header Actions (CTA + Hotline + Portal) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Hotline CTA button -->
      <a
        href={`tel:${SITE.hotlineTel}`}
        class="hidden sm:inline-flex h-10 lg:h-11 rounded-full px-4 lg:px-6 bg-[linear-gradient(102deg,#B68D2E_0%,#8C6B1F_100%)] text-white font-bold text-[12px] lg:text-[13px] tracking-wide items-center gap-2 shadow-[0_8px_20px_rgba(182,141,46,0.3)] hover:brightness-[1.08] hover:shadow-[0_10px_28px_rgba(182,141,46,0.42)] transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Báo giá {SITE.hotline}</span>
      </a>

      <!-- Quick Call Button on Mobile (<sm) -->
      <a
        href={`tel:${SITE.hotlineTel}`}
        class="sm:hidden h-10 w-10 rounded-full bg-[linear-gradient(102deg,#B68D2E_0%,#8C6B1F_100%)] text-white grid place-items-center shadow-[0_4px_12px_rgba(182,141,46,0.35)] active:scale-95 transition"
        title="Gọi báo giá"
        aria-label="Gọi báo giá sỉ"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </a>

      <!-- Dealer Portal Link -->
      <a
        href="/dai-ly/dang-nhap"
        class="h-10 px-3 sm:px-3.5 rounded-full border border-[#B68D2E]/25 text-[#8C6B1F] bg-[#fdfbf3] hover:border-[#B68D2E] hover:bg-[#fdf6de] text-[12px] font-bold uppercase tracking-wider flex items-center gap-1.5 transition-colors active:scale-95"
        title="Đăng nhập Cổng đại lý B2B"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#B68D2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="hidden md:inline">Đại lý</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="ltb-menu-toggle"
        class="lg:hidden h-10 w-10 rounded-full border border-[#ece6d3] bg-white text-[#1a1a1a] grid place-items-center shadow-sm hover:border-[#B68D2E] active:scale-95 transition-all"
        aria-expanded="false"
        aria-controls="ltb-mobile-menu"
        aria-label="Mở danh mục điều hướng"
      >
        <!-- Icon Menu -->
        <svg id="ltb-icon-open" class="h-5 w-5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <!-- Icon Close -->
        <svg id="ltb-icon-close" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="ltb-mobile-menu" class="hidden lg:hidden border-t border-[#ece6d3] bg-white/98 backdrop-blur-lg shadow-[0_20px_40px_rgba(0,0,0,0.12)]">
    <div class="px-4 py-4 flex flex-col gap-1.5 max-h-[calc(100vh-80px)] overflow-y-auto">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`text-left py-3 px-4 rounded-xl font-semibold transition flex items-center justify-between text-[14px] ${
            active === item.key
              ? 'bg-[#fdf6de] text-[#8C6B1F] border border-[#e8d9a8]'
              : 'text-[#1a1a1a] hover:bg-[#faf6e9]'
          }`}
        >
          <span>{item.label}</span>
          {active === item.key && <span class="h-2 w-2 rounded-full bg-[#B68D2E]"></span>}
        </a>
      ))}
      <div class="pt-2 border-t border-[#f0ebd9] mt-1 space-y-2">
        <a
          href={`tel:${SITE.hotlineTel}`}
          class="h-12 rounded-full bg-[linear-gradient(102deg,#B68D2E_0%,#8C6B1F_100%)] text-white font-extrabold flex items-center justify-center gap-2 shadow-[0_6px_16px_rgba(182,141,46,0.3)] text-[14px]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Gọi báo giá sỉ {SITE.hotline}</span>
        </a>
        <a
          href="/dai-ly/dang-nhap"
          class="h-11 rounded-full border border-[#B68D2E]/30 bg-[#fdfbf3] text-[#8C6B1F] font-bold flex items-center justify-center gap-2 text-[13px]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#B68D2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Truy cập Cổng Đại Lý B2B</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('ltb-menu-toggle');
  const mobileMenu = document.getElementById('ltb-mobile-menu');
  const iconOpen = document.getElementById('ltb-icon-open');
  const iconClose = document.getElementById('ltb-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isClosed = mobileMenu?.classList.toggle('hidden');
    const isOpen = !isClosed;
    toggleBtn.setAttribute('aria-expanded', String(isOpen));
    if (iconOpen && iconClose) {
      if (isOpen) {
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    }
  });

  // Close menu on navigation click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
