---
import { SITE } from '../lib/site';
interface Props { active?: string }
const { active = '' } = Astro.props;
const nav = [
  { key: 'trang-chu', label: 'Trang chủ', href: '/' },
  { key: 'gioi-thieu', label: 'Giới thiệu', href: '/gioi-thieu' },
  { key: 'san-pham', label: 'Sản phẩm', href: '/san-pham' },
  { key: 'doi-tac-phan-phoi', label: 'Đối tác phân phối', href: '/doi-tac-phan-phoi' },
  { key: 'tin-tuc', label: 'Tin tức', href: '/tin-tuc' },
  { key: 'lien-he', label: 'Liên hệ', href: '/lien-he' },
];
const on = 'bg-primary-container text-on-primary font-semibold';
const off = 'font-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high';
---
<header class="fixed top-0 left-0 right-0 z-50 bg-surface border-b border-outline-variant/30">
  <div class="h-20 w-full px-gutter-mobile md:px-margin-tablet lg:px-margin flex items-center justify-between gap-space-sm">
    <a href="/" class="flex items-center gap-space-md min-w-0" aria-label="Long Thanh Beer — Trang chủ">
      <img src="/brand/ltb-monogram.svg" alt="Logo Long Thanh Beer (LTB)" width="40" height="40" class="h-10 w-auto object-contain inline-block mr-3 shrink-0" />
      <div class="flex flex-col border-l border-outline-variant/40 pl-space-md">
        <span class="font-label-lg text-primary tracking-tight font-bold uppercase leading-none">LTB</span>
        <span class="font-label-sm text-on-surface-variant tracking-wider uppercase mt-0.5 leading-none">Long Thanh Beer</span>
      </div>
    </a>

    <nav class="hidden xl:flex items-center gap-space-xs p-1 bg-surface-container/60 rounded" aria-label="Điều hướng chính">
      {nav.map((n) => (
        <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
           class={`px-space-md py-space-xs rounded transition-colors ${active === n.key ? on : off}`}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-space-md shrink-0">
      <a class="hidden sm:flex flex-col text-right pr-space-sm" href={`tel:${SITE.hotlineTel}`}>
        <span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Hotline B2B</span>
        <span class="font-label-lg text-primary font-bold tracking-tight">{SITE.hotline}</span>
      </a>
      <a class="hidden md:inline-flex items-center justify-center px-space-md py-2.5 rounded bg-secondary text-on-secondary hover:bg-on-secondary-container font-label-lg transition-colors" href="/doi-tac-phan-phoi">Hợp tác phân phối</a>
      <a href="/dai-ly/dang-nhap" class="w-8 h-8 rounded-full bg-primary flex items-center justify-center" aria-label="Đăng nhập đại lý" title="Đăng nhập đại lý">
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </a>
      <!-- Menu di động (<xl): bổ sung để điều hướng được ở 360/768px -->
      <button type="button" id="ltb-menu-btn" class="xl:hidden w-10 h-10 rounded border border-outline-variant flex items-center justify-center text-primary" aria-expanded="false" aria-controls="ltb-mobile-nav" aria-label="Mở menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
  <nav id="ltb-mobile-nav" class="hidden xl:hidden border-t border-outline-variant/30 bg-surface px-gutter-mobile md:px-margin-tablet py-space-sm" aria-label="Điều hướng di động">
    <ul class="flex flex-col">
      {nav.map((n) => (
        <li><a href={n.href} aria-current={active === n.key ? 'page' : undefined}
          class={`block px-space-md py-3 rounded font-label-lg ${active === n.key ? on : 'text-on-surface-variant hover:bg-surface-container-high'}`}>{n.label}</a></li>
      ))}
      <li class="pt-space-sm"><a href="/doi-tac-phan-phoi" class="block text-center px-space-md py-3 rounded bg-secondary text-on-secondary font-label-lg">Hợp tác phân phối</a></li>
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('ltb-menu-btn');
  const nav = document.getElementById('ltb-mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
  });
</script>
